{
  "$schema": "https://raw.githubusercontent.com/Jani-shiv/WinDevOpsHub/main/config/schemas/tools.schema.json",
  "version": "1.0.0",
  "tools": [
    {
      "id": "git",
      "name": "Git",
      "category": "development",
      "description": "Distributed version control system",
      "packageManager": "winget",
      "packageId": "Git.Git",
      "command": "git",
      "versionArg": "--version",
      "required": true,
      "homepage": "https://git-scm.com",
      "notes": "Core dependency for most development workflows"
    },
    {
      "id": "github-cli",
      "name": "GitHub CLI",
      "category": "development",
      "description": "Official GitHub command-line interface",
      "packageManager": "winget",
      "packageId": "GitHub.cli",
      "command": "gh",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://cli.github.com"
    },
    {
      "id": "7zip",
      "name": "7-Zip",
      "category": "utilities",
      "description": "High-compression archive tool",
      "packageManager": "winget",
      "packageId": "7zip.7zip",
      "command": "7z",
      "versionArg": "i",
      "required": false,
      "homepage": "https://www.7-zip.org"
    },
    {
      "id": "curl",
      "name": "curl",
      "category": "utilities",
      "description": "Command-line tool for HTTP/HTTPS/FTP transfers",
      "packageManager": "winget",
      "packageId": "curl.curl",
      "command": "curl",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://curl.se",
      "notes": "Windows 11 includes curl.exe natively; this installs the latest standalone version"
    },
    {
      "id": "jq",
      "name": "jq",
      "category": "utilities",
      "description": "Lightweight command-line JSON processor",
      "packageManager": "winget",
      "packageId": "jqlang.jq",
      "command": "jq",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://jqlang.github.io/jq/"
    },
    {
      "id": "yq",
      "name": "yq",
      "category": "utilities",
      "description": "YAML/JSON/TOML processor — jq for YAML",
      "packageManager": "winget",
      "packageId": "MikeFarah.yq",
      "command": "yq",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://github.com/mikefarah/yq"
    },
    {
      "id": "clink",
      "name": "Clink",
      "category": "terminal",
      "description": "Bash-like line editing and history for cmd.exe",
      "packageManager": "winget",
      "packageId": "chrisant996.Clink",
      "command": "clink",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://chrisant996.github.io/clink/"
    },
    {
      "id": "openssh",
      "name": "OpenSSH Client",
      "category": "utilities",
      "description": "Secure Shell client (SSH, SCP, SFTP)",
      "packageManager": "windows-feature",
      "packageId": "OpenSSH.Client~~~~0.0.1.0",
      "command": "ssh",
      "versionArg": "-V",
      "required": false,
      "notes": "Installed via Windows Optional Features (DISM). Requires administrator rights."
    },
    {
      "id": "docker",
      "name": "Docker Desktop",
      "category": "containers",
      "description": "Container platform for Windows",
      "packageManager": "winget",
      "packageId": "Docker.DockerDesktop",
      "command": "docker",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://www.docker.com/products/docker-desktop/",
      "notes": "Requires admin for service installation. Restart may be required."
    },
    {
      "id": "kubectl",
      "name": "kubectl",
      "category": "kubernetes",
      "description": "Kubernetes command-line tool",
      "packageManager": "winget",
      "packageId": "Kubernetes.kubectl",
      "command": "kubectl",
      "versionArg": "version --client",
      "required": false,
      "homepage": "https://kubernetes.io/docs/tasks/tools/",
      "notes": "Also available via Docker Desktop. WinGet installs the standalone client."
    },
    {
      "id": "helm",
      "name": "Helm",
      "category": "kubernetes",
      "description": "Kubernetes package manager",
      "packageManager": "winget",
      "packageId": "Helm.Helm",
      "command": "helm",
      "versionArg": "version --short",
      "required": false,
      "homepage": "https://helm.sh"
    },
    {
      "id": "k9s",
      "name": "k9s",
      "category": "kubernetes",
      "description": "Terminal UI for Kubernetes clusters",
      "packageManager": "winget",
      "packageId": "Derailed.k9s",
      "command": "k9s",
      "versionArg": "version",
      "required": false,
      "homepage": "https://k9scli.io"
    },
    {
      "id": "terraform",
      "name": "Terraform",
      "category": "infrastructure",
      "description": "Infrastructure as Code tool by HashiCorp",
      "packageManager": "winget",
      "packageId": "Hashicorp.Terraform",
      "command": "terraform",
      "versionArg": "version",
      "required": false,
      "homepage": "https://www.terraform.io"
    },
    {
      "id": "aws-cli",
      "name": "AWS CLI",
      "category": "cloud",
      "description": "Amazon Web Services command-line interface",
      "packageManager": "winget",
      "packageId": "Amazon.AWSCLI",
      "command": "aws",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://aws.amazon.com/cli/"
    },
    {
      "id": "azure-cli",
      "name": "Azure CLI",
      "category": "cloud",
      "description": "Microsoft Azure command-line interface",
      "packageManager": "winget",
      "packageId": "Microsoft.AzureCLI",
      "command": "az",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://docs.microsoft.com/en-us/cli/azure/"
    },
    {
      "id": "gcloud",
      "name": "Google Cloud CLI",
      "category": "cloud",
      "description": "Google Cloud Platform command-line interface",
      "packageManager": "winget",
      "packageId": "Google.CloudSDK",
      "command": "gcloud",
      "versionArg": "version",
      "required": false,
      "homepage": "https://cloud.google.com/sdk"
    },
    {
      "id": "pwsh",
      "name": "PowerShell 7",
      "category": "shell",
      "description": "Cross-platform PowerShell (Core edition)",
      "packageManager": "winget",
      "packageId": "Microsoft.PowerShell",
      "command": "pwsh",
      "versionArg": "--version",
      "required": true,
      "homepage": "https://aka.ms/powershell"
    },
    {
      "id": "windows-terminal",
      "name": "Windows Terminal",
      "category": "terminal",
      "description": "Modern terminal application by Microsoft",
      "packageManager": "winget",
      "packageId": "Microsoft.WindowsTerminal",
      "command": "wt",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://aka.ms/windowsterminal"
    },
    {
      "id": "vscode",
      "name": "Visual Studio Code",
      "category": "development",
      "description": "Lightweight, extensible code editor",
      "packageManager": "winget",
      "packageId": "Microsoft.VisualStudioCode",
      "command": "code",
      "versionArg": "--version",
      "required": false,
      "homepage": "https://code.visualstudio.com"
    }
  ]
}
